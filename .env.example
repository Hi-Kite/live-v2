# =====================================================================
#  LIVE v2 — environment configuration
#  Copy to `.env` and edit ALL values before deploying.
# =====================================================================

# ---------- Public site URL (used in emails, OAuth callbacks, etc.) ----------
# Must be the HTTPS URL users actually visit. NO trailing slash.
APP_NAME=LIVE
APP_URL=https://live.example.com
BACKEND_CORS_ORIGINS=https://live.example.com

# ---------- 备案号（页脚展示；留空则不显示）----------
# 国内服务器运营需要填写自有备案号。海外服务器留空即可。
# ICP 备案（工信部），例如：豫ICP备2024XXXXXX号
ICP_NUMBER=
ICP_URL=https://beian.miit.gov.cn
# 公安备案（可选），例如：豫公网安备 410XXXXXXXXXXXXX号
MPS_NUMBER=
MPS_URL=http://www.beian.gov.cn

# ---------- Browser-facing endpoints (used by frontend client bundle) ----------
# These are baked into the frontend at BUILD time.
# After changing them you MUST run:  docker compose build frontend
# NOTE: origin ONLY, no /api suffix — the frontend prefixes /api itself.
PUBLIC_API_BASE=https://live.example.com
PUBLIC_WS_BASE=wss://live.example.com

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_DATABASE=livedb
MYSQL_USER=liveuser
MYSQL_PASSWORD=CHANGE_ME_strong_db_password
# NOTE: under Docker Compose DATABASE_URL is derived automatically from
# MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE — do NOT set it here.
# Only export it for local (non-Docker) development, e.g.:
# DATABASE_URL=mysql://liveuser:password@localhost:3306/livedb

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- JWT secrets (use long random strings!) ----------
# Generate with:  openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_run_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_hex_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- CSRF ----------
CSRF_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# ---------- SMTP (for email verification + live notifications) ----------
SMTP_HOST=smtphz.qiye.163.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=LIVE
SMTP_FROM_ADDRESS=noreply@example.com

# ---------- SRS media server ----------
# CANDIDATE = this server's PUBLIC IPv4 (required for WebRTC).
# Find with:  curl -s ifconfig.me   (run on the server)
SRS_CANDIDATE=203.0.113.10
# Debug-only host ports, bound to 127.0.0.1 (never exposed publicly):
SRS_HTTP_PORT=8081
SRS_API_PORT=1985

# ---------- Streaming push/playback (optional overrides) ----------
# Hostname shown in OBS push URLs (rtmp://<host>:1935/live/).
# Leave empty to derive from APP_URL's host.
PUBLIC_RTMP_HOST=
# Base URL for browser playback links (FLV/HLS). Leave empty to use
# relative paths served through nginx (/streams/live/<slug>.flv) —
# recommended. Only set this if streams are served from another origin.
PUBLIC_STREAM_BASE=

# ---------- Admin bootstrap (auto-seeded on first run) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_INVITE_CODE=CHANGE_ME_initial_invite_code

# ---------- Rate limits (optional override) ----------
RATE_LIMIT_LOGIN_TTL=60
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_REGISTER_TTL=3600
RATE_LIMIT_REGISTER_LIMIT=10
RATE_LIMIT_MESSAGE_TTL=60
RATE_LIMIT_MESSAGE_LIMIT=10
